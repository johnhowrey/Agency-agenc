# Drama Nerd Designs — Automation Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.

# === Etsy API ===
ETSY_API_KEY=your_etsy_api_keystring_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
# Shop name: dramanerddesign | Account: john@musicaltheatrehistory.com
ETSY_SHOP_ID=your_numeric_shop_id_here

# These are set automatically after first OAuth login:
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# === Gmail Notifications ===
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
NOTIFICATION_EMAIL=john@musicaltheatrehistory.com

# === Shop Settings ===
SHOP_NAME=Drama Nerd Designs
SHIP_FROM_NAME=John Howrey
SHIP_FROM_STREET=your_street_address
SHIP_FROM_CITY=Palm Springs
SHIP_FROM_STATE=CA
SHIP_FROM_ZIP=your_zip_code
SHIP_FROM_COUNTRY=US

# === Order Monitor ===
# How often to check for new orders (in seconds)
POLL_INTERVAL=300
